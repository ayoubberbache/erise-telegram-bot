# =====================================================================
# HNS RE2SD Resources Bot - Environment Configuration
# =====================================================================

# Your Telegram Bot Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Port for the internal HTTP health check server (Render automatically sets this)
PORT=10000

# Your public Render application URL (used for internal 10-minute keep-alive pings)
# e.g., https://hns-re2sd-bot.onrender.com
APP_URL=https://your-service-name.onrender.com

# Interval in minutes for keep-alive pings (Default: 10 minutes)
PING_INTERVAL_MINUTES=10

# GitHub Repository URL
GITHUB_REPO_URL=https://github.com/ayoubberbache/erise-telegram-bot

# Empty button display mode: "disappear" (default, hide empty buttons) or "grey" (show dimmed empty buttons)
EMPTY_BUTTON_MODE=disappear
